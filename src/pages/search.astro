---
import Base from '../layouts/Base.astro';
---
<Base title="Search">
  <link slot="head" href="/pagefind/pagefind-ui.css" rel="stylesheet" />
  <div class="page-hero">
    <div class="blob"></div>
    <div class="wrap">
      <nav class="crumbs" aria-label="Breadcrumb"><a href="/">Home</a><span>/</span><span>Search</span></nav>
      <h1>Search</h1>
    </div>
  </div>
  <div class="wrap search-wrap"><div id="search"></div></div>
  <script is:inline src="/pagefind/pagefind-ui.js"></script>
  <script is:inline>
    window.addEventListener('DOMContentLoaded', function () {
      if (window.PagefindUI) new PagefindUI({ element: '#search', showSubResults: true, showImages: false, autofocus: true });
      else document.getElementById('search').textContent = 'Search is available on the built site.';
    });
  </script>
</Base>
