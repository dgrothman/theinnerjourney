---
import Base from '../layouts/Base.astro';
import StoneStrip from '../components/StoneStrip.astro';
---
<Base title="Page not found">
  <div class="page-hero">
    <div class="blob"></div>
    <div class="wrap">
      <p class="kicker">404</p>
      <h1>This page has moved on</h1>
      <p class="lede">The site was reorganized in fall 2026. Try one of the five topics, or <a href="/search/">search</a>.</p>
      <StoneStrip />
      <p style="margin-top:28px"><a class="btn btn-primary" href="/">Go home</a></p>
    </div>
  </div>
</Base>
