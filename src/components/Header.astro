---
import { TERM } from '../data/site';

const path = Astro.url.pathname;
const links = [
  { href: '/class/', label: 'This Term' },
  { href: '/topics/', label: 'Topics' },
  { href: '/audio/', label: 'Audio' },
  { href: '/resources/', label: 'Resources' },
];
const current = (href: string) => (path.startsWith(href) ? 'page' : undefined);
const signup = TERM ? TERM.signupUrl : '/#join';
---
<header class="site-head">
  <div class="wrap">
    <a class="brand" href="/">
      <img src="/logo.svg" alt="" width="42" height="42" />
      <div><b>The Inner Journey</b><span>Finding Peace Within</span></div>
    </a>
    <nav class="nav" aria-label="Main">
      {links.map((l) => <a href={l.href} aria-current={current(l.href)}>{l.label}</a>)}
      <a class="icon-btn" href="/search/" aria-label="Search the site">
        <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" aria-hidden="true"><circle cx="11" cy="11" r="7" /><path d="m20 20-3.5-3.5" /></svg>
      </a>
      <a class="btn btn-primary btn-sm" href={signup}>{TERM ? 'Sign up' : 'Join the list'}</a>
      <details class="menu">
        <summary class="icon-btn" aria-label="Menu">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.75" stroke-linecap="round" aria-hidden="true"><path d="M4 7h16M4 12h16M4 17h16" /></svg>
        </summary>
        <nav aria-label="Mobile">
          {links.map((l) => <a href={l.href}>{l.label}</a>)}
          <a href="/search/">Search</a>
        </nav>
      </details>
    </nav>
  </div>
</header>
